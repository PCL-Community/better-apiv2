# PostgreSQL Database URL
# Example: postgresql://user:password@localhost:5432/pcl_ce_api
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/pcl_ce_api?schema=public"

# Server Port
PORT=3000

# CORS 允许的前端域名（不设置则允许任意来源，生产环境请设置为前端域名）
CORS_ORIGIN=http://localhost:5173

# Node Environment
NODE_ENV="development"

# GitHub OAuth for Admin Login
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:3000/auth/github/callback"
GITHUB_ORG="PCL-Community"
# GitHub 团队 slug（逗号分隔多个团队，任一团队成员即可登录）
GITHUB_TEAM_SLUG="ce-core,ce-dev"
# GitHub API 代理（可选，优先级高于 HTTPS_PROXY / HTTP_PROXY / ALL_PROXY）
# 例如: http://127.0.0.1:7890
GITHUB_PROXY=""

# Admin Session
ADMIN_SESSION_TTL_HOURS=24

REDIS_URL=redis://default:password@localhost:6379

# 存储服务配置
# ─────────────────────────────────────────────────────────────────────
# 两种模式任选其一:
#
# 【模式 A: 多后端（推荐）】同时上传到多个 S3 兼容存储
# 设置 S3_BACKENDS 为一个 JSON 数组，每个后端包含:
#   name        - 后端名称（必填）
#   endpoint    - S3 兼容 API 地址（可选，默认 AWS）
#   bucket      - 存储桶名称（必填）
#   region      - 区域（可选，默认 auto）
#   accessKey   - 访问密钥（可选）
#   secretKey   - 密钥（可选）
#   publicBaseUrl - 公网访问域名（可选，用于构造下载 URL）
#   forcePathStyle - 强制路径风格（可选，默认 true）
#
# S3_BACKENDS='[{"name":"minio","endpoint":"https://minio.internal:9000","bucket":"better-apiv2","accessKey":"admin","secretKey":"admin","publicBaseUrl":"https://cdn1.example.com","region":"auto","forcePathStyle":true},{"name":"r2","endpoint":"https://xxx.r2.cloudflarestorage.com","bucket":"better-apiv2","accessKey":"xxx","secretKey":"xxx","publicBaseUrl":"https://cdn2.example.com","region":"auto","forcePathStyle":false}]'
#
# 【模式 B: 传统单后端】保持原有配置不变
# 可选值: 's3' | 'r2' | 'local'
STORAGE_PROVIDER=local
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=pcl-community
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# 本地存储目录（在 STORAGE_PROVIDER=local 时使用）
UPLOAD_DIR=./uploads

# 补丁生成并发数
PATCH_CONCURRENCY=2

BSDIFF_COMMAND="path/to/bsdiff"
BSPATCH_COMMAND="path/to/bspatch"
